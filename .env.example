# Copy to .env and fill in real values. Never commit .env.
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_CURRENCY=RWF
PAWAPAY_COUNTRY=RWA

# Password for the administrator login created on the first page load.
# Leave empty to have one generated and written to admin-initial-password.txt
# in the project root. Either way, change it after the first sign-in.
ADMIN_INITIAL_PASSWORD=
