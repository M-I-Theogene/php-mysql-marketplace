$base = 'http://localhost/shopping/'
$pages = @('about-us.php','contact-us.php','privacy-policy.php','terms.php','refund-policy.php','index.php')
foreach ($p in $pages) {
    try {
        $r = Invoke-WebRequest -Uri ($base + $p) -UseBasicParsing -TimeoutSec 20
        $html = $r.Content
        $old = ([regex]::Matches($html, '784\s*801\s*809')).Count
        $new = ([regex]::Matches($html, '792\s*359\s*800')).Count
        $office = ([regex]::Matches($html, 'Office:')).Count
        Write-Output ("{0}  status={1}  old={2}  new={3}  'Office:'={4}" -f $p, $r.StatusCode, $old, $new, $office)
    } catch {
        Write-Output ("{0}  ERROR {1}" -f $p, $_.Exception.Message)
    }
}
